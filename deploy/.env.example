# =====================================================================================================
#  IAML - настройки сервера.
#
#  Рабочий файл называется  .env , лежит рядом с docker-compose.yml и НЕ попадает в git (репозиторий публичный).
#  Создать его проще всего так (секреты сгенерируются сами):
#
#      ./deploy/gen-env.sh DOMAIN=iaml.example.org ACME_EMAIL=you@example.org
#
#  Потом откройте .env (nano .env) и впишите RESEND_API_KEY. Подробности: docs/DEPLOY.md.
#
#  Формат: одна переменная на строку, без пробелов вокруг "=". Значение с пробелами или символами < > $ -
#  в одинарных кавычках: MAIL_FROM='IAML <no-reply@iaml.example.org>'. Строки с "#" - комментарии.
#  Если обязательная переменная пуста, `docker compose` остановится с понятным сообщением.
# =====================================================================================================


# ----------------------------------------------------------------------------- ОБЯЗАТЕЛЬНЫЕ ---------

# Домен сайта: без https:// и без "/". A-запись домена в DNS уже должна указывать на этот сервер.
DOMAIN=

# Реальный e-mail администратора: на него Let's Encrypt шлёт предупреждения об истечении сертификата.
ACME_EMAIL=

# Пароль PostgreSQL. Генерирует gen-env.sh. Только латинские буквы и цифры (пароль подставляется в URL).
# ВАЖНО: PostgreSQL запоминает пароль при ПЕРВОМ запуске. Поменять его здесь позже недостаточно -
# см. docs/OPERATIONS.md, раздел «Смена пароля базы данных».
POSTGRES_PASSWORD=

# Секрет подписи одноразовых кодов и ссылок «отписаться» (не короче 32 символов). Генерирует gen-env.sh.
# Не меняйте без необходимости: см. docs/OPERATIONS.md, раздел «Секреты».
SESSION_SECRET=

# Resend (отправка писем). Ключ с правом "Sending access" (см. docs/DEPLOY.md, шаг 7).
RESEND_API_KEY=

# От чьего имени уходят письма. Адрес должен быть на домене, подтверждённом в Resend.
# Пример: MAIL_FROM='IAML <no-reply@iaml.example.org>'
MAIL_FROM=


# ----------------------------------------------------------------------------- НЕОБЯЗАТЕЛЬНЫЕ --------
# Раскомментируйте строку (уберите "#"), только если действительно нужно изменить значение по умолчанию.

# Публичный адрес сайта. По умолчанию это https://<DOMAIN>. Нужен только для нестандартных случаев.
# Должен совпадать с адресом в браузере (иначе формы дают ошибку 403 csrf).
#SITE_URL=

# Перенаправлять www.<домен> на <домен>. Сначала создайте A-запись для www в DNS!
#WWW_HOST=www.iaml.example.org

# Часовой пояс сайта (даты в письмах, время рассылок). Etc/GMT-3 = UTC+3.
#SITE_TZ=Etc/GMT-3
# Час (по SITE_TZ), в который уходят ежедневные/еженедельные дайджесты Mongolist, и день недели (1 = понедельник).
#DIGEST_HOUR=8
#DIGEST_WEEKDAY=1

# Пауза между письмами (мс). Бесплатный Resend пропускает 2 запроса в секунду; 600 - с запасом.
#MAIL_MIN_INTERVAL_MS=600

# Уровень журнала приложения: debug | info | warn | error
#LOG_LEVEL=info

# Имя пользователя и база PostgreSQL. Менять можно только ДО первого запуска.
#POSTGRES_USER=iaml
#POSTGRES_DB=iaml

# Порты на сервере (если 80/443 заняты чем-то ещё). Для Let's Encrypt нужны именно 80 и 443.
#HTTP_PORT=80
#HTTPS_PORT=443

# Потолки памяти контейнеров. Для сервера с 1 ГБ RAM значения по умолчанию подходят.
#APP_MEM_LIMIT=768m
#DB_MEM_LIMIT=512m
#CADDY_MEM_LIMIT=256m
