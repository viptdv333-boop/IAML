# IAML application image: the Fastify backend plus the static site it serves.
# Build context is the repository root:   docker build -t iaml-app .
# The allow-list .dockerignore keeps logo/, docs/, .git, .env*, backups and node_modules out of the context.

ARG NODE_VERSION=24

# ---------------------------------------------------------------- stage 1: production dependencies
FROM node:${NODE_VERSION}-bookworm-slim AS deps
WORKDIR /app
COPY backend/package.json backend/package-lock.json ./
# sharp ships prebuilt libvips binaries as optional packages (@img/sharp-linux-x64 / -arm64),
# so no compiler and no apt packages are needed on bookworm-slim.
# The lockfile carries no "libc" hints, so npm also unpacks the musl (Alpine) builds - ~20 MB that this
# glibc image never loads; they are removed again.
RUN npm ci --omit=dev --no-audit --no-fund \
 && npm cache clean --force \
 && rm -rf node_modules/@img/*linuxmusl*

# ---------------------------------------------------------------- stage 2: runtime image
FROM node:${NODE_VERSION}-bookworm-slim AS runtime

LABEL org.opencontainers.image.title="IAML site" \
      org.opencontainers.image.description="International Association for Mongolic Linguistics: web site and API" \
      org.opencontainers.image.source="https://github.com/viptdv333-boop/IAML"

ENV NODE_ENV=production \
    PORT=3000 \
    STATIC_DIR=/app/public \
    UPLOADS_DIR=/data/uploads

WORKDIR /app

# backend: code, SQL migrations, seed data, CLI scripts (root-owned and read-only for the app user)
COPY --from=deps /app/node_modules ./node_modules
COPY backend/package.json backend/package-lock.json ./
COPY backend/src ./src
COPY backend/migrations ./migrations
COPY backend/seeds ./seeds
COPY backend/scripts ./scripts

# static site: ONLY what backend/src/plugins/static.js is allowed to serve
# (root *.html, iaml-site.css, favicon.svg, site.webmanifest, assets/**, site/**).
# robots.txt, sitemap.xml and the manifest start_url are generated by the app from SITE_URL.
COPY *.html iaml-site.css favicon.svg site.webmanifest ./public/
COPY assets ./public/assets
COPY site ./public/site

COPY deploy/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN sed -i 's/\r$//' /usr/local/bin/docker-entrypoint.sh \
 && chmod 0755 /usr/local/bin/docker-entrypoint.sh \
 && mkdir -p /data/uploads \
 && chown node:node /data/uploads

# Avatars live here. A named volume mounted on this path inherits the node:node ownership set above.
VOLUME ["/data/uploads"]

USER node
EXPOSE 3000

# 200 from /api/health means "the process is up AND PostgreSQL answers" (503 otherwise).
# --start-interval (Docker Engine 25+): probe every 2 s while starting, so `up -d` returns quickly,
# then every 30 s (every probe is one line in the app log).
HEALTHCHECK --interval=30s --start-interval=2s --timeout=5s --start-period=40s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:' + (process.env.PORT || 3000) + '/api/health', { signal: AbortSignal.timeout(4000) }).then((r) => process.exit(r.ok ? 0 : 1), () => process.exit(1))"]

# seed (idempotent) -> exec node src/server.js ; see deploy/docker-entrypoint.sh
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["node", "src/server.js"]
