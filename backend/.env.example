# Development settings for the backend:   cd backend && cp .env.example .env && npm run dev
# backend/.env is ignored by git. Production does NOT use this file: it runs in Docker and is configured by
# ../deploy/.env.example (see ../docs/DEPLOY.md). Every variable is documented in ../docs/API.md, section 8.

NODE_ENV=development
PORT=3000
#HOST=0.0.0.0

# PostgreSQL 16. A throw-away database for development:
#   docker run -d --name iaml-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=iaml -p 5432:5432 postgres:16-bookworm
DATABASE_URL=postgres://postgres:postgres@localhost:5432/iaml

# Public origin of the site, no trailing slash. Drives the CSRF origin check, the cookie "Secure" flag and the
# links in e-mails. For local work keep it equal to the address you open in the browser.
SITE_URL=http://localhost:3000

# HMAC key for e-mail codes and unsubscribe links: at least 32 random characters. Generate one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- mail ---
# log    = nothing is delivered; every message stays in the table mail_outbox (read one-time codes there)
# resend = real delivery through the Resend HTTP API (needs RESEND_API_KEY and MAIL_FROM)
MAIL_TRANSPORT=log
#RESEND_API_KEY=
#MAIL_FROM="IAML <no-reply@localhost>"
#MAIL_MIN_INTERVAL_MS=600

# --- optional (defaults shown) ---
#TRUST_PROXY=false
#STATIC_DIR=../
#UPLOADS_DIR=./data/uploads
#SITE_TZ=Etc/GMT-3
#DIGEST_HOUR=8
#DIGEST_WEEKDAY=1
#MIGRATE_ON_START=true
#JOBS_ENABLED=true
#DB_POOL_MAX=10
#LOG_LEVEL=debug
