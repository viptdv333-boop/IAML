{
  "name": "iaml-backend",
  "version": "1.0.0",
  "private": true,
  "description": "IAML website backend (Fastify + PostgreSQL)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env src/migrate.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "seed:demo": "node --env-file-if-exists=.env scripts/seed.js --demo",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.js",
    "test": "node --test --test-concurrency=1 --test-timeout=90000 \"test/*.test.js\"",
    "check": "node --check src/server.js",
    "i18n:check": "node scripts/i18n-check.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "pino-pretty": "^13.1.3"
  }
}
